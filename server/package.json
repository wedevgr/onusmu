{
  "name": "ai-memory-server",
  "version": "0.1.0",
  "private": true,
  "description": "AI Memory backend: uploads, STT pipeline, embeddings, hybrid search, RAG chat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/apply-migrations.ts",
    "encrypt:existing": "tsx scripts/encrypt-existing.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "openai": "^4.67.0",
    "pg": "^8.13.0",
    "stripe": "^17.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3"
  }
}
