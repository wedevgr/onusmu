# Server
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Supabase (project settings -> API)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Speech-to-text
STT_PROVIDER=whisper            # whisper | deepgram
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=
# OpenAI transcription model ("whisper" provider); far better on Greek than whisper-1.
STT_MODEL=gpt-4o-transcribe
# Force a language (e.g. el). Empty detects it per chunk, so a note spoken in another language
# is not forced into Greek.
STT_LANGUAGE=el                 # el (default) | auto | any ISO-639-1 code

# Embeddings + LLM
# After changing EMBEDDING_MODEL, run `npm run reembed` (questions and transcripts must use the same model).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536              # must match supabase/migrations vector dim
# Chat answers, query planning, search filtering.
LLM_MODEL=gpt-4o-mini
# Reads each recording for tasks, money and readings; more consistent than gpt-4o-mini.
EXTRACT_MODEL=gpt-4.1-mini
#
# One-time after migrations 0011 and 0012, to build from existing recordings:
#   npm run terms:build   (names list)
#   npm run facts:build   (money, debts, readings; add -- --with-tasks <user_id> for old tasks)

# Limits / queue
MAX_UPLOAD_MB=25
JOB_POLL_MS=2000

# Recording quotas reset at midnight (daily) / on the 1st (monthly) in this timezone.
BILLING_TIMEZONE=Europe/Athens

# Verify the database server's certificate. Path to the CA file (or the PEM text itself).
# Supabase: Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate.
# Leave empty only for local development: the connection is then encrypted but unverified.
DATABASE_CA_CERT=

# At-rest encryption for transcripts, stored audio and chat data (AES-256-GCM).
# Losing a key makes all data encrypted with it unreadable: keep a backup outside the server.
#
# To rotate keys:
#   1. ENCRYPTION_KEYS=1:<current key>,2:<new key>   and   ENCRYPTION_ACTIVE_KEY_ID=2
#   2. restart the server, then run: npm run encrypt:existing
#   3. when it reports 0 values left, remove key 1 from ENCRYPTION_KEYS
# ENCRYPTION_KEYS=
# ENCRYPTION_ACTIVE_KEY_ID=
#
# Set to true once `npm run encrypt:existing` reports 0 values left: the server then
# refuses plaintext / old-format values instead of reading them.
# ENCRYPTION_REJECT_LEGACY=false
#
# Single-key setup: this is key "1".
# 64 hex chars, generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=

# Stripe (website subscriptions). Leave empty to run without payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <API_URL>/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Where checkout and the billing portal send people back to (the website, no trailing slash)
WEBSITE_URL=https://your-website.example
# Price ids default to the Onusmu product in config.ts; set these only to override (e.g. test mode).
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_UNLIMITED=

# reCAPTCHA secret key for website sign-up. Empty turns /v1/auth/signup off.
RECAPTCHA_SECRET_KEY=
