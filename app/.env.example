# Supabase project credentials (Auth only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL.
# iOS simulator / web: http://localhost:8787
# Android emulator must use http://10.0.2.2:8787 (maps to host localhost)
EXPO_PUBLIC_API_URL=http://localhost:8787

# Website with the /account page, where plans are bought (e.g. https://example.com).
# Leave empty to hide the in-app upgrade buttons.
EXPO_PUBLIC_WEBSITE_URL=https://onusmu.com
